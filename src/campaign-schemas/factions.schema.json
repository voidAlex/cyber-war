{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campaign-schemas/factions.schema.json",
  "title": "CampaignFactions",
  "description": "阵营定义（id/名称/颜色/立场/最高统帅人格/战区司令/后勤/学说）。严格校验供 ajv 导入包。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "side": { "type": "string", "enum": ["player", "enemy", "ally", "neutral"] },
      "commanderId": { "type": "string", "minLength": 1 },
      "theaterCommanderIds": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "supply": {
        "type": "object",
        "properties": {
          "supplies": { "type": "number", "minimum": 0, "maximum": 100 },
          "ammunition": { "type": "number", "minimum": 0, "maximum": 100 },
          "fuel": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["supplies", "ammunition", "fuel"],
        "additionalProperties": false
      },
      "trust": {
        "type": "object",
        "patternProperties": {
          "^[A-Za-z0-9_-]+$": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      },
      "relations": {
        "type": "object",
        "description": "第 5 批：对外定性关系（多阵营支撑）。key=对方 factionId，value=关系类别。",
        "patternProperties": {
          "^[A-Za-z0-9_-]+$": {
            "type": "string",
            "enum": ["hostile", "at_war", "allied", "neutral"]
          }
        },
        "additionalProperties": false
      },
      "doctrineTags": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "description": { "type": "string", "maxLength": 2000 },
      "publicWill": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "description": "T2 第 3 批：民心/战意初值（缺省 60）。每回合由 updatePublicWill 调整（胜+3/败-5/低补给-2/回合-1）。publicWill<20 触发兵变惩罚。"
      },
      "internationalOpinion": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "description": "T2 第 3 批：国际舆论初值（缺省 50）。internationalOpinion<30 时军援（reinforcement）事件被中断。"
      }
    },
    "required": ["id", "name", "color", "side", "commanderId", "supply", "doctrineTags"],
    "additionalProperties": false
  }
}
