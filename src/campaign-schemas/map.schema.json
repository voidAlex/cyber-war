{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campaign-schemas/map.schema.json",
  "title": "CampaignMap",
  "description": "战役地图（网格/地形/高价值节点）。TODO(M2/M4): 由后续子代理补全 ajv schema。",
  "type": "object",
  "properties": {
    "gridType": { "type": "string", "enum": ["square", "hex"] },
    "cols": { "type": "integer", "minimum": 1 },
    "rows": { "type": "integer", "minimum": 1 }
  },
  "required": ["gridType", "cols", "rows"]
}
